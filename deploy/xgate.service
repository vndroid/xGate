[Unit]
Description=xGate CIDR allowlist port forwarder (control plane)
Documentation=https://github.com/vndroid/xGate
# 排在 nftables.service 之后，避免它的 "flush ruleset" 清掉 xgate 表。
# 启动时 xgate 会在一个 nft 事务里加载规则并恢复白名单，之后才开放 API。
After=network-pre.target nftables.service
Wants=network-pre.target

[Service]
Type=simple
ExecStart=/usr/local/bin/xgate serve -config /etc/xgate/config.yaml
# 停止或重启只影响控制面，内核规则保持不变，转发不中断。
Restart=on-failure
RestartSec=2s

# 以非 root 用户运行（由 deploy/xgate.sysusers 创建），只授予管理网络所需的
# CAP_NET_ADMIN；nft、conntrack、ss 子进程会继承这项能力。xgate 组的成员可以
# 读取配置并访问 unix socket 形式的 API。
User=xgate
Group=xgate
# 已有的 /var/lib/xgate 若属于其它用户，systemd 启动时会递归改为 xgate 所有。
StateDirectory=xgate
StateDirectoryMode=0750
RuntimeDirectory=xgate
RuntimeDirectoryPreserve=yes

CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
